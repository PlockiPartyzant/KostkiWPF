<Window x:Class="KostkiWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gra w kości"
        Height="650"
        Width="450"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#ED27C121">

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                <Image x:Name="Kosc1"
                       Width="100"
                       Height="100"
                       Margin="10"
                       Stretch="Uniform"
                       Source="Images/kosc0.png"
                       MouseLeftButtonDown="Kosc_Click"/>

                <Image x:Name="Kosc2"
                       Width="100"
                       Height="100"
                       Margin="10"
                       Stretch="Uniform"
                       Source="Images/kosc0.png"
                       MouseLeftButtonDown="Kosc_Click"/>

            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                <Image x:Name="Kosc3"
                       Width="100"
                       Height="100"
                       Margin="10"
                       Stretch="Uniform"
                       Source="Images/kosc0.png"
                       MouseLeftButtonDown="Kosc_Click"/>

                <Image x:Name="Kosc4"
                       Width="100"
                       Height="100"
                       Margin="10"
                       Stretch="Uniform"
                       Source="Images/kosc0.png"
                       MouseLeftButtonDown="Kosc_Click"/>

                <Image x:Name="Kosc5"
                       Width="100"
                       Height="100"
                       Margin="10"
                       Stretch="Uniform"
                       Source="Images/kosc0.png"
                       MouseLeftButtonDown="Kosc_Click"/>

            </StackPanel>

            <Button x:Name="RzutButton"
                    Content="RZUT"
                    Width="120"
                    Height="50"
                    Margin="10"
                    Background="#ED275021"
                    Foreground="White"
                    FontSize="18"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Click="RzutButton_Click"/>

            <TextBlock x:Name="WynikTextBlock"
                       Text="0"
                       FontSize="40"
                       Margin="10"
                       HorizontalAlignment="Center"
                       Foreground="Black"/>

        </StackPanel>

    </Grid>

</Window>